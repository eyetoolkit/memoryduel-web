# Cloudflare Pages _headers file
# 安全头和缓存策略 - 记忆对决 MemoryDuel 纯静态站点

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://*.google-analytics.com https://www.googletagmanager.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# HTML 短缓存 1 分钟（2026-10-29：600→60。600 会让发版后已打开过的
# 用户最多 10 分钟看不到新版——图标改版当天实测撞上；60s 与 /battle 对齐）
/
  Cache-Control: public, max-age=60, must-revalidate

# PWA manifest 短期缓存
/manifest*.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# sitemap / llms / ai / robots 短缓存
/sitemap*.xml
  Cache-Control: public, max-age=3600
/llms*.txt
  Cache-Control: public, max-age=3600, must-revalidate
/ai.txt
  Cache-Control: public, max-age=3600, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

# sw.js 永不缓存控制（线上注册的 SW；2026-10-21 删除了从未注册的 service-worker.js 规则）
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# 阻止 .git 暴露（防御性，CF Pages 不暴露 .git）
/.git/*
  X-Robots-Tag: noindex

# Battle / train HTML: short edge cache so quiz-data ?v= bumps land fast
/train.html
  Cache-Control: public, max-age=60, must-revalidate
/battle
  Cache-Control: public, max-age=60, must-revalidate
/battle/
  Cache-Control: public, max-age=60, must-revalidate
/assets/quiz-data.js
  Cache-Control: public, max-age=300, must-revalidate

# service worker 永不缓存（浏览器拿到旧 SW 会锁死更新，必须每次回源）
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
